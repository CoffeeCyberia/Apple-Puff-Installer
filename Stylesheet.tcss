Screen {
    layout: vertical;
}

.title {
    width: 100%;
    background: #fdf6e3;
    text-align: center;
}
#button1area {
    width: 100%;
    height: 1fr;
    align: center middle;
    background: #fdf6e3;
}
#button2area {
    background: #fdf6e3;
    color: #5c6a72;
    align-horizontal: center;
    width: 100%;
    
}
.button1 {
    width: 16;
    height: 3;
    background: #efebd4;
    color: #5c6a72;
    margin-bottom: 1;
    border: none;
    
    }
.button1:hover{             /* used ai for the hover thing */
    background: #93B259;
    color: #efebd4;
}
.button1:focus{             /* used ai for the focus thing */
    background: #93B259;
    color: #efebd4;
}
.Installation{
    background: #fdf6e3;
    text-align: center;
    width: 100%;
    align-horizontal: center;
    }

.InstallationTabs{
    background: #fdf6e3;
    border: none;               /* used ai for the border things */
    border-bottom: none;        /* used ai for the border things */
}
TabbedContent.Installation Tabs {
    width: 100%;
}
TabbedContent.Installation Tab {  /* used ai for the .Installation Tab */
    background: #efebd4;
    color: #5c6a72;
    border: none;
    width: 1fr;                     /* used ai for the .Installation Tab */
}
TabbedContent.Installation Tab.-active {  /* used ai for the .Installation Tab.-active */
    background: #93B259;
    color: #efebd4;
}

TabbedContent.Installation Tab:hover {  /* used ai for the .Installation Tab.-active */
    background: #93B259;
    color: #efebd4;
}
TabbedContent.Installation Underline {  /* used ai  */
    display: none;                      /* used ai  */
}
SeconndScreen {
    height: 100%;
    overflow-y: hidden;
}
.DevSecText{
    width: 100%;
}
.DevSec{
    text-align: center;
    align-horizontal: center
}


RadioSet {  /* used ai  */
    background: #efebd4;
    color: #5c6a72;
    border: tall #5C6A72;
    width: 60;
}
RadioSet:focus {    /* used ai  */
    border: tall #93B259;
}
RadioSet:focus > RadioButton.-selected { /* used ai  */
    background: #93B259;
    color: #efebd4;
    text-style: bold;
}
RadioButton > .toggle--button {     /* used ai  */
    color: #5c6a72;
    background: #E6E2CC;
}
RadioButton.-on > .toggle--button {     /* used ai  */
    color: #93B259;
}
RadioButton:hover {
    background: #93B259 40%;
}
RadioSet:focus > RadioButton.-selected > .toggle--label {       /* used ai  */
    background: #93B259;
    color: #efebd4;
    text-style: bold;
}
.RadioSetDisk{
    align-horizontal: center;
    margin-top: 3;
}
RadioSet > RadioButton.-selected > .toggle--label {     /* used ai  */
    background: #93B259 50%;
    color: #5c6a72;
    text-style: none;
}

Select > SelectCurrent{
    background: #efebd4 ;
    border: tall #5c6a72 ;
}
Select:focus > SelectCurrent {
    border: tall #93B259;
}

SelectCurrent Static#label {
    color: #5c6a72;
}
Select > SelectOverlay > .option-list--option-disabled {
    color: #5c6a72;
}

Select > SelectOverlay {
    border: tall #93B259;
    background: #efebd4;
    color: #5c6a72;
}

.select1{
    width: 60;
    color: #5c6a72;
    margin-top: 1;
}

SelectOverlay > .option-list--option-disabled {
    color: #5c6a72;
}

SelectOverlay > .option-list--option-highlighted {
    background: #93B259;
    color: #efebd4;
}

#SelectNetworkInterface{

}

Input {
    background: #efebd4;
    color: #5c6a72;
    border: tall #5c6a72;
    margin-top: 1;
}

Input:focus {
    border: tall #93B259;
}

Input > .input--placeholder {
    color: #5c6a72 50%;
}

Input > .input--cursor {
    background: #93B259;
    color: #efebd4;
}

Input > .input--selection {
    background: #93B259 50%;
}

Input.-invalid {
    border: tall #F85552 60%;
}

Input.-invalid:focus {
    border: tall #F85552;
}

#SSID-Select {
    display: none;
}
#EnterWLANPassword {
    display: none;
    width: 60;
}
#ConnectWLANButton {
    display: none;
    margin-top: 1;
    width: 10;
    align-horizontal: center;
}

#ConnectionStatus{
    display: none;
    margin-top: 1;
    color: white;
    text-align: center;
    width: 60;
}


AutoComplete {
    & AutoCompleteList {
        max-height: 8;                 /* rows visible before scrolling */
        background: #efebd4;
        color: #5c6a72;
        border-left: wide #93B259;
    }

    & .autocomplete--highlight-match {
        color: #efebd4;
        text-style: bold;
    }

    & .option-list--option-highlighted {
        background: #93B259;
        color: #efebd4;
        text-style: bold;
    }
}